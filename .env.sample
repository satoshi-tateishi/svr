# ============================================================
# svr 環境変数サンプル
# このファイルをコピーして .env を作成してください
# cp .env.sample .env
# ============================================================

# Django 基本設定
SECRET_KEY=change-me-in-production-use-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# CSRF 設定（開発環境）
CSRF_TRUSTED_ORIGINS=http://localhost:8085,http://127.0.0.1:8085

# ============================================================
# shin•on Portal JWT 連携設定
# ============================================================

# JWKS エンドポイント
# 開発環境: Docker 内から portal-app コンテナへ直接アクセス
# 本番環境: https://portal.shin-on1981.com/api/jwks/
PORTAL_JWKS_URL=http://portal-app:8000/api/jwks/

# JWT 検証パラメータ（ポータルの設定と完全一致させること）
PORTAL_JWT_ISSUER=https://portal.shin-on1981.com
PORTAL_JWT_AUDIENCE=shin-on-apps

# ポータルのログインページ URL（未認証時にリダイレクトする先）
# 開発環境: http://localhost/login/
# 本番環境: https://portal.shin-on1981.com/login/
PORTAL_LOGIN_URL=http://localhost/login/

# ============================================================
# shin-on_db 内部API 設定
# ============================================================
# Docker コンテナ名で指定（shin-on-internal ネットワーク参加が必要）
SHIN_ON_DB_API_URL=http://shin-on_db_app

# ============================================================
# データベース設定（MySQL 8.4）
# ============================================================
DATABASE_URL=mysql://svr_user:svr_password@db:3306/svr_db
MYSQL_DATABASE=svr_db
MYSQL_USER=svr_user
MYSQL_PASSWORD=svr_password
MYSQL_ROOT_PASSWORD=root_password

# ============================================================
# Redis 設定（セッション・Celery Broker）
# ============================================================
REDIS_URL=redis://redis:6379/0
